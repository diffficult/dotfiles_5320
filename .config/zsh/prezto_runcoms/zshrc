#
# PREZTO INITIALIZATION
#
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

#
# CORE CONFIGURATION
#

# Prezto's completion module already initializes compinit.

# Load shared aliases and functions between zsh/bash
if [[ -f ~/.aliasrc ]]; then
    source "$HOME/.aliasrc"
fi

# Source secrets if found on functions directory
if [[ -f "$HOME/.config/functions/.secrets" ]]; then
  source "$HOME/.config/functions/.secrets"
fi

# Source function directory
if [[ -d "$HOME/.config/functions" ]]; then
  for f in "$HOME"/.config/functions/*; do
    [[ -f "$f" && -r "$f" ]] || continue
    source "$f"
  done
fi

#
# FZF CONFIGURATION
#
export FZF_BASE=/usr/share/fzf

# Load FZF widgets only for real interactive TTY shells.
if [[ -o interactive && -o zle && -t 0 && -t 1 ]]; then
  if [[ -f "/usr/share/fzf/key-bindings.zsh" ]]; then
    source "/usr/share/fzf/key-bindings.zsh"
  fi

  if [[ -f "/usr/share/fzf/completion.zsh" ]]; then
    source "/usr/share/fzf/completion.zsh"
  fi
fi

# Tokyo Night color theme for FZF
export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS \
--color=fg:#c0caf5,bg:#1a1b26,hl:#ff9e64 \
--color=fg+:#c0caf5,bg+:#292e42,hl+:#ff9e64 \
--color=info:#7aa2f7,prompt:#7dcfff,pointer:#7dcfff \
--color=marker:#9ece6a,spinner:#9ece6a,header:#9ece6a"

# FD integration for FZF
export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

# FZF completion functions
_fzf_compgen_path() {
  fd --hidden --exclude .git . "$1"
}

_fzf_compgen_dir() {
  fd --type=d --hidden --exclude .git . "$1"
}

# FZF-git integration
if [[ -f "$HOME/dev/gits/fzf-git.sh/fzf-git.sh" ]]; then
  source "$HOME/dev/gits/fzf-git.sh/fzf-git.sh"
fi

# BAT integration for preview
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always --line-range :500 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"

# Advanced FZF completion customization
_fzf_comprun() {
  local command=$1
  shift

  case "$command" in
    cd)           fzf --preview 'eza --tree --color=always {} | head -200' "$@" ;;
    export|unset) fzf --preview "eval 'echo \$'{}"         "$@" ;;
    ssh)          fzf --preview 'dig {}'                   "$@" ;;
    *)            fzf --preview "bat -n --color=always --line-range :500 {}" "$@" ;;
  esac
}

#
# BAT CONFIGURATION
#
export BAT_THEME=tokyonight_night

# GREP COLORS (ripgrep-like match highlight)
export GREP_COLORS="mt=01;31"
alias grep="grep --color=auto"

#
# COMMAND-NOT-FOUND HANDLERS
#

# Source find-the-command
if [[ -f "/usr/share/doc/find-the-command/ftc.zsh" ]]; then
  source "/usr/share/doc/find-the-command/ftc.zsh"
fi

#
# DEVELOPMENT TOOLS
#

# NVM configuration
if [[ -f /usr/share/nvm/init-nvm.sh ]]; then
  source /usr/share/nvm/init-nvm.sh
fi

# Ruby GEM configuration
if (( $+commands[ruby] )); then
  export GEM_HOME="$(ruby -e 'puts Gem.user_dir')"
  export PATH="$PATH:$GEM_HOME/bin"
fi

#
# UTILITY TOOLS
#

# Navi command line cheatsheets
if (( $+commands[navi] )); then
  source <(navi widget zsh)
fi

# pay-respects (rust alternative to thefuck)
if (( $+commands[pay-respects] )); then
  eval "$(pay-respects zsh --alias)"
fi

#
# APPLICATION SPECIFIC
#

# YTFZF configuration for rofi
export YTFZF_EXTMENU='rofi -dmenu -fuzzy -width 1000'
export YTFZF_ENABLE_FZF_DEFUALT_OPTS=0

# Autosuggestion color configuration
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'

# X-cmd initialization
[ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X" # boot up x-cmd.

if [[ -f /etc/bash_completion.d/climate_completion ]]; then
  source /etc/bash_completion.d/climate_completion
fi
# opencode
export PATH=/home/poole/.opencode/bin:$PATH

# Warmind CLI completions — auto-installed by warmind installer
if [[ -f "/home/poole/.config/warmind/cli/completion.zsh" ]]; then
  source "/home/poole/.config/warmind/cli/completion.zsh"
fi

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
