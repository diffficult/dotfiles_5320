{
  "hyprland/workspaces": {
    "disable-scroll": true,
    "active-only": false,
    "all-outputs": false,
    "enable-bar-scroll": true,
    "format": "<span font_desc='JetBrainsMono Nerd Font Bold 12'>{name}</span> {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
    "window-rewrite": {
      // warmind-webapps:start
      // warmind-webapp:gmail:start
      "class<brave-www.gmail.com__-Default>": "<span font_desc='JetBrainsMono Nerd Font 14'>󰊫</span>",
      // warmind-webapp:gmail:end
      // warmind-webapp:claude:start
      "class<brave-claude.ai__-Default>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      // warmind-webapp:claude:end
      // warmind-webapp:proton-mail:start
      "class<brave-mail.proton.me__-Default>": "<span font_desc='JetBrainsMono Nerd Font 14'>󰗰</span>",
      // warmind-webapp:proton-mail:end
      // warmind-webapps:end
//      "class<dev.zed.Zed>": "󰰸",
      "class<sublime_text>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      "class<swayimg>": "<span font_desc='JetBrainsMono Nerd Font 14'>󱢉</span>",
      "class<org.gnome.FileRoller>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      "class<nvidia-settings>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      "class<org.gnome.Software>": "<span font_desc='JetBrainsMono Nerd Font 14'>󰚰</span>",
      "class<syncthing-gtk>": "<span font_desc='JetBrainsMono Nerd Font 14'>󱍸</span>",
      "class<polychromatic>": "<span font_desc='JetBrainsMono Nerd Font 14'>󰰠</span>",
      "class<mpv> title<^101$>": "󰖠",  // outside cam
      "class<mpv> title<^watch\\?v=.*>": " ",  // Use your desired symbol (e.g.,  for YouTube; escape ? as \\?)
      "class<zen> title<.*youtube.*>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      "class<firefox>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      "class<zen>": "<span font_desc='JetBrainsMono Nerd Font 14'>󰰸</span>",
      "class<zen> title<.*WhatsApp.*>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      "class<zen> title<Home / X.*>": "<span font_desc='JetBrainsMono Nerd Font 14'>󰰰</span>",
      "class<zen> title<.*Gmail.*>": "<span font_desc='JetBrainsMono Nerd Font 14'>󰊫</span>",
      "class<firefox> title<.*github.*>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      "class<google-chrome>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      "class<google-chrome-unstable>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
      "class<brave-word\\.cloud\\.microsoft__-Default>": "<span font_desc='JetBrainsMono Nerd Font 14'></span>",
